#!/bin/bash
# Managed by SEQS. Run by a dom0 panel monitor every two seconds: shows the
# traffic of the GnosisVPN qube VM's tunnel. The panel interprets markup in
# what this prints, so it accepts only four numbers from the qube, and it never
# starts the qube.
vm="${1:-}"
[[ "${vm}" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ ]] || { echo " VPN: n/a"; exit 0; }
out="$(timeout 5 qvm-run --no-autostart --pass-io -- "${vm}" seqs-gnosisvpn-rates 2>/dev/null | head -c 100)"
[[ "${out}" =~ ^[0-9]{1,19}\ [0-9]{1,19}\ [0-9]{1,19}\ [0-9]{1,19}$ ]] || { echo " VPN: n/a"; exit 0; }
read -r rx tx drx dtx <<< "${out}"
h() { numfmt --to=iec-i --suffix=B --format='%.2f' "$1"; }
printf ' ↑ %s (+ %s), ↓ %s (+ %s)\n' "$(h "${tx}")" "$(h "${dtx}")" "$(h "${rx}")" "$(h "${drx}")"
