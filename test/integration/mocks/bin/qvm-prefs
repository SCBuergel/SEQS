#!/usr/bin/env bash
# Mock qvm-prefs -- VM netvm [VALUE]. SEQS_MOCK_NETVM_STATE stores one
# "<vm> <netvm>" pair per line and supports mutation; the legacy scalar is used
# by setup-qubes air-gap scenarios when no state file is configured.
args=()
for arg in "$@"; do
	case "${arg}" in --) ;; *) args+=("${arg}") ;; esac
done
vm="${args[0]:-}"
property="${args[1]:-}"
value="${args[2]:-}"

# "qvm-prefs VM" lists netvm and default_dispvm as qvm-prefs does: flag "-"
# for an explicit value, "D" for an inherited one (SEQS_MOCK_PREFS_INHERITED=1).
if [ "${#args[@]}" -eq 1 ]; then
	flag="-"; [ "${SEQS_MOCK_PREFS_INHERITED:-}" = 1 ] && flag="D"
	for prop in default_dispvm netvm; do
		v="$("$0" -- "${vm}" "${prop}")"
		printf '%-21s %s  %s\n' "${prop}" "${flag}" "${v:-None}"
	done
	exit 0
fi

# SEQS_MOCK_PREFS: optional "<vm> <property> <value>" lines, read first.
if [ -n "${SEQS_MOCK_PREFS:-}" ] && [ "${#args[@]}" -eq 2 ] \
	&& awk -v v="${vm}" -v p="${property}" '$1 == v && $2 == p { print $3; f=1 } END { exit !f }' "${SEQS_MOCK_PREFS}"; then
	exit 0
fi

if [ "${vm}" = "disp-updates" ] && [ "${property}" = "klass" ]; then
	echo "DispVM"
	exit 0
fi
if [ "${vm}" = "disp-updates" ] && [ "${property}" = "template" ]; then
	echo "default-dvm"
	exit 0
fi
if [ "${vm}" = "disp-updates" ] && [ "${property}" = "netvm" ]; then
	echo "sys-firewall"
	exit 0
fi
if [ "${vm}" = "default-dvm" ] && [ "${property}" = "klass" ]; then
	echo "AppVM"
	exit 0
fi
if [ "${vm}" = "default-dvm" ] && [ "${property}" = "template" ]; then
	echo "debian-13-xfce"
	exit 0
fi
if [ "${vm}" = "debian-13-xfce" ] && [ "${property}" = "klass" ]; then
	echo "TemplateVM"
	exit 0
fi
if [ "${vm}" = "sys-firewall" ] && [ "${property}" = "klass" ]; then
	echo "AppVM"
	exit 0
fi
if [ "${vm}" = "sys-firewall" ] && [ "${property}" = "template" ]; then
	echo "debian-13-xfce"
	exit 0
fi
if [ "${vm}" = "sys-firewall" ] && [ "${property}" = "netvm" ]; then
	echo "sys-net"
	exit 0
fi

if [ "${property}" = "template" ] && [ "${vm#A-}" != "${vm}" ]; then
	echo "Z-${vm#A-}"
	exit 0
fi

if [ "${property}" = "default_dispvm" ] && [ "${#args[@]}" -lt 3 ]; then
	echo "${SEQS_MOCK_DEFAULT_DISPVM:-}"
	exit 0
fi

if [ -n "${SEQS_MOCK_NETVM_STATE:-}" ] && [ "${property}" = netvm ]; then
	if [ "${#args[@]}" -ge 3 ]; then
		tmp="${SEQS_MOCK_NETVM_STATE}.tmp"
		awk -v vm="${vm}" -v value="${value}" '
			$1 == vm { print vm, value; found=1; next }
			{ print }
			END { if (!found) print vm, value }
		' "${SEQS_MOCK_NETVM_STATE}" > "${tmp}"
		mv "${tmp}" "${SEQS_MOCK_NETVM_STATE}"
		exit 0
	fi
	awk -v vm="${vm}" '$1 == vm { print $2; found=1 } END { exit !found }' \
		"${SEQS_MOCK_NETVM_STATE}"
	exit $?
fi

[ "${property}" = "netvm" ] && echo "${SEQS_MOCK_NETVM:-}"
