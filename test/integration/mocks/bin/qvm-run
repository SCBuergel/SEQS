#!/usr/bin/env bash
# Mock qvm-run: the installer's only VM->dom0 dataflows are
#   qvm-run -p REPO_VM "git ... rev-parse ... HEAD^{commit}"
#   qvm-run -p REPO_VM "git ... cat-file ... && ... && git ... archive ..."
#   qvm-run -p -u root Z-gnosisvpn "apt-get update && ..." (shown sanitized)
# Emit the requested result. The export command runs as sent, against
# SEQS_REPO_ROOT in place of the repository path, so that its checks are the
# runner's own. SEQS_MOCK_TAR overrides the archive payload so a
# scenario can feed a hostile archive; SEQS_MOCK_ENDLESS=commit|archive makes
# that answer a 20 MB stream, more than either limit, and the mock appends
# "commit" or "archive" to SEQS_MOCK_ENDLESS_LOG only if the reader took it
# all. An endless stream would fill memory when a limit is missing.
endless() {
  yes | head -c 20000000 && echo "${SEQS_MOCK_ENDLESS}" >> "${SEQS_MOCK_ENDLESS_LOG:-/dev/null}"
  exit 0
}
# Every answer also carries terminal control bytes (OSC, BEL, C1), on stderr
# from the repository qube and on stdout from apt: none may reach the
# terminal raw (HOSTILE-REPO and HOSTILE-APT name them in the output). apt's
# also holds invalid UTF-8 (0xFF), and exits SEQS_MOCK_APT_RC.
case "$*" in
  *"Z-gnosisvpn"*"apt-get update"*"openresolv"*)
    printf 'apt: \e]0;HOSTILE-APT\a\xc2\x9b\xff done\n'
    exit "${SEQS_MOCK_APT_RC:-0}"
    ;;
esac
printf '\e]0;HOSTILE-REPO\a\xc2\x9b\n' >&2
case "$*" in
  *"rev-parse --verify HEAD^{commit}"*)
    [ "${SEQS_MOCK_ENDLESS:-}" != commit ] || endless
    printf '%s\n' "${SEQS_MOCK_RESOLVED_COMMIT:-${SEQS_EXPECTED_COMMIT:?SEQS_EXPECTED_COMMIT unset}}"
    exit 0
    ;;
  *"cat-file -e ${SEQS_EXPECTED_COMMIT:?SEQS_EXPECTED_COMMIT unset}^{commit}"*"archive --format=tar ${SEQS_EXPECTED_COMMIT} -- salt install-scripts"*) ;;
  *) exit 64 ;;
esac
[ "${SEQS_MOCK_ENDLESS:-}" != archive ] || endless
if [ -n "${SEQS_MOCK_TAR:-}" ]; then
  cat "${SEQS_MOCK_TAR}"
else
  [[ "$3" =~ ^git\ -C\ ([^\ ]+)\  ]]
  exec bash -c "${3//"git -C ${BASH_REMATCH[1]} "/"git -C ${SEQS_REPO_ROOT:?SEQS_REPO_ROOT unset} "}"
fi
